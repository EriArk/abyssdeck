<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.6</Version>
    <AssemblyName>CodexWeb.Companion</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <EmbeddedResource Include="../../ops/windows/Read-CompanionInventory.ps1" Link="Read-CompanionInventory.ps1" />
    <EmbeddedResource Include="../../ops/windows/Repair-CompanionComponent.ps1" Link="Repair-CompanionComponent.ps1" />
    <EmbeddedResource Include="../../ops/windows/Migrate-CompanionWorker.ps1" Link="Migrate-CompanionWorker.ps1" />
    <EmbeddedResource Include="Assets/update-public.txt" LogicalName="CodexWeb.Companion.Assets.update-public.pem" />
    <AvaloniaResource Include="../web/public/icon-192.png" Link="Assets/icon.png" />
  </ItemGroup>
</Project>
